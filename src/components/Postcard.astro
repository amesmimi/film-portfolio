---
import { site } from '../site.config';
const endpoint = site.formEndpoint;
const firstName = site.name.split(' ')[0];
---
<form
  class="postcard"
  method="POST"
  action={endpoint || undefined}
  data-endpoint={endpoint}
  aria-describedby="postcard-status"
>
  <div class="postcard__message">
    <label for="pc-message" class="hand">Dear {firstName},</label>
    <textarea id="pc-message" name="message" rows="6" required placeholder="write your note here…"></textarea>
  </div>

  <div class="postcard__address">
    <div class="postcard__stamp stamp" aria-hidden="true">
      <div>
        <svg width="40" height="40" viewBox="0 0 42 42" fill="none" stroke="var(--ink)" stroke-width="1.6"><path d="M26 5a16 16 0 1 0 11 27A13 13 0 0 1 26 5z" fill="var(--parchment)" /></svg>
      </div>
    </div>
    <label class="field">Your name
      <input type="text" name="name" autocomplete="name" required />
    </label>
    <label class="field">Your email
      <input type="email" name="email" autocomplete="email" required />
    </label>
    <!-- spam trap: real people never see or fill this -->
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="trap" aria-hidden="true" />
    <input type="hidden" name="_subject" value="A letter from the website" />
    <button type="submit" class="btn">Post it <span aria-hidden="true">✉</span></button>
    <p id="postcard-status" class="status hand" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('form.postcard')) {
    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        status.textContent = 'The post box isn’t hooked up just yet — please try again soon!';
        return;
      }
      button.disabled = true;
      status.textContent = 'Licking the stamp…';
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = 'Your letter is on its way. Thank you!';
      } catch {
        status.textContent = 'Oh dear, the letter got lost. Please try once more.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .postcard {
    background: var(--print-white); border: 1.5px solid var(--ink); border-radius: 4px;
    box-shadow: 6px 8px 0 rgba(59, 42, 30, 0.14);
    display: flex; flex-wrap: wrap; transform: rotate(-0.6deg);
  }
  .postcard__message {
    flex: 1 1 420px; min-width: 0; padding: 36px 40px;
    border-right: 1px dashed rgba(59, 42, 30, 0.4);
    display: flex; flex-direction: column; gap: 10px;
  }
  @media (max-width: 780px) {
    .postcard__message { border-right: none; border-bottom: 1px dashed rgba(59, 42, 30, 0.4); }
  }
  textarea {
    font-family: var(--font-hand); font-size: 24px; line-height: 40px; color: var(--ink);
    border: none; resize: vertical; padding: 0; min-height: 240px;
    background: repeating-linear-gradient(transparent 0 39px, rgba(59, 42, 30, 0.3) 39px 40px);
  }
  textarea:focus, input:focus { outline: 2px dashed var(--accent); outline-offset: 4px; }
  .postcard__address { flex: 1 1 320px; min-width: 0; padding: 36px 40px; display: flex; flex-direction: column; gap: 22px; }
  .postcard__stamp { align-self: flex-end; width: 96px; padding: 9px; }
  .postcard__stamp > div {
    aspect-ratio: 4 / 5; background: var(--tone-blue); border: 1px solid var(--ink);
    display: flex; align-items: center; justify-content: center;
  }
  .field { display: flex; flex-direction: column; gap: 2px; font-family: var(--font-caps); font-size: 16px; letter-spacing: 0.14em; }
  .field input {
    font-family: var(--font-hand); font-size: 24px; letter-spacing: 0; color: var(--ink);
    border: none; border-bottom: 1.5px solid var(--ink); background: transparent; padding: 6px 0; min-height: 44px;
  }
  .btn { align-self: flex-start; margin-top: 8px; background: var(--accent); box-shadow: 3px 4px 0 var(--ink); }
  .btn:hover { box-shadow: 5px 6px 0 var(--ink); }
  .btn:disabled { opacity: 0.6; cursor: wait; }
  .status { margin: 0; min-height: 1.3em; color: var(--accent); }
  .trap { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
</style>
