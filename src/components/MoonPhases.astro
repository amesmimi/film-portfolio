---
// A row of moon phases: new → full → new. Used as the night-time divider.
interface Props { size?: number; class?: string }
const { size = 264, class: cls } = Astro.props;

const r = 7;
const K = 0.5523;
const f = (n: number) => +n.toFixed(2);
// The lit part is the area between two half-ellipses from pole to pole,
// one bulging to x = R·r and the other to x = L·r.
function moon(R: number, L: number) {
  const a = R * r, b = L * r, k = K * r;
  return `M0,${-r}C${f(a * K)},${-r} ${f(a)},${f(-k)} ${f(a)},0C${f(a)},${f(k)} ${f(a * K)},${r} 0,${r}` +
    `C${f(b * K)},${r} ${f(b)},${f(k)} ${f(b)},0C${f(b)},${f(-k)} ${f(b * K)},${-r} 0,${-r}Z`;
}
const phases: [number, number][] = [];
for (let i = 0; i <= 4; i++) phases.push([1, Math.cos((Math.PI * i) / 4)]); // waxing
for (let i = 1; i <= 4; i++) phases.push([Math.cos((Math.PI * i) / 4), -1]); // waning
---
<svg class={cls} width={size} height={size / 11} viewBox="0 0 264 24" aria-hidden="true">
  {phases.map(([R, L], i) => (
    <g transform={`translate(${12 + i * 30} 12)`}>
      {i === 4 && <circle r="10" fill="var(--honey)" opacity="0.16" />}
      <circle r={r} fill="none" stroke="var(--honey)" stroke-opacity="0.45" stroke-width="0.8" />
      <path d={moon(R, L)} fill="var(--honey)" />
    </g>
  ))}
</svg>
