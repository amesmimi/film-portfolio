---
// Hand-drawn ornaments. One stroke weight, faded watercolour fills.
// All decorative: hidden from screen readers.
interface Props {
  name: 'moon' | 'star' | 'sprig' | 'vine' | 'flourish' | 'mushroom' | 'leaves' | 'rule' | 'book' | 'camera' | 'arrow'
    | 'moth' | 'candle' | 'constellation' | 'crescent' | 'sun';
  size?: number;
  color?: string;
  class?: string;
  style?: string;
}
const { name, size, color = 'var(--ink)', class: cls, style } = Astro.props;
---
{name === 'moon' && (
  <svg class={cls} style={style} width={size ?? 42} height={size ?? 42} viewBox="0 0 42 42" fill="none" stroke={color} stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M26 5a16 16 0 1 0 11 27A13 13 0 0 1 26 5z" /><path d="M33 9l1 3 3 1-3 1-1 3-1-3-3-1 3-1z" fill="var(--honey)" stroke="none" /></svg>
)}
{name === 'star' && (
  <svg class={cls} style={style} width={size ?? 40} height={size ?? 40} viewBox="0 0 60 60" aria-hidden="true"><path d="M30 4l3 23 23 3-23 3-3 23-3-23-23-3 23-3z" fill={color === 'var(--ink)' ? 'var(--honey)' : color} /></svg>
)}
{name === 'sprig' && (
  <svg class={cls} style={style} width={size ?? 54} height={(size ?? 54) / 3} viewBox="0 0 54 18" fill="none" stroke="var(--moss)" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><path d="M2 9h40" /><path d="M14 9q4-7 10-6-3 6-10 6z" /><path d="M26 9q4 7 10 6-3-6-10-6z" /><circle cx="47" cy="9" r="3.5" /></svg>
)}
{name === 'vine' && (
  <svg class={cls} style={style} width={size ?? 140} height={(size ?? 140) * 1.29} viewBox="0 0 140 180" fill="none" stroke="var(--moss)" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M120 176C88 140 40 110 30 20" /><path d="M58 112q-22-6-28-24 20 2 28 24z" fill="var(--tone-sage)" /><path d="M42 70q-20-10-22-30 18 6 22 30z" fill="var(--tone-sage)" /><path d="M80 140q4-22 24-30-2 20-24 30z" fill="var(--tone-sage)" /><circle cx="30" cy="16" r="9" fill="var(--tone-peach)" /><circle cx="30" cy="16" r="3" fill="var(--honey)" stroke="none" /></svg>
)}
{name === 'flourish' && (
  <svg class={cls} style={style} width={size ?? 90} height={(size ?? 90) / 3} viewBox="0 0 90 30" fill="none" stroke={color} stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><path d="M4 15q20-10 41 0 21 10 41 0" /><circle cx="45" cy="15" r="6" fill="var(--tone-peach)" /><circle cx="45" cy="15" r="2" fill="var(--toadstool)" stroke="none" /><path d="M20 10q2-7 9-7-2 6-9 7zM70 20q-2 7-9 7 2-6 9-7z" fill="var(--tone-sage)" /></svg>
)}
{name === 'mushroom' && (
  <svg class={cls} style={style} width={size ?? 110} height={size ?? 110} viewBox="0 0 110 110" fill="none" stroke={color} stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="M30 70q25-50 50 0z" fill="var(--toadstool)" /><circle cx="45" cy="58" r="3" fill="var(--print-white)" stroke="none" /><circle cx="60" cy="52" r="4" fill="var(--print-white)" stroke="none" /><circle cx="68" cy="63" r="2.5" fill="var(--print-white)" stroke="none" /><path d="M48 70v18q7 5 14 0V70" fill="var(--print-white)" /><path d="M20 92q35-6 70 0" /></svg>
)}
{name === 'leaves' && (
  <svg class={cls} style={style} width={size ?? 80} height={size ?? 80} viewBox="0 0 80 80" fill="var(--tone-sage)" stroke="var(--moss)" stroke-width="1.3" aria-hidden="true"><path d="M10 70Q30 40 70 10" fill="none" /><path d="M30 46q-14-4-18-18 14 2 18 18zM46 30q2-14 16-18-2 14-16 18zM20 60q-12 0-18-10 12-2 18 10z" /></svg>
)}
{name === 'rule' && (
  <svg class={cls} style={style} width={size ?? 120} height={(size ?? 120) / 7.5} viewBox="0 0 120 16" fill="none" stroke="var(--moss)" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><path d="M2 8h116" /><path d="M50 8q5-7 10 0 5 7 10 0" /></svg>
)}
{name === 'book' && (
  <svg class={cls} style={style} width={size ?? 70} height={(size ?? 70) * 0.57} viewBox="0 0 70 40" fill="none" stroke={color} stroke-width="1.3" aria-hidden="true"><path d="M35 34V10M35 10C25 4 12 4 4 8v24c8-4 21-4 31 2 10-6 23-6 31-2V8c-8-4-21-4-31 2z" /></svg>
)}
{name === 'camera' && (
  <svg class={cls} style={style} width={size ?? 40} height={(size ?? 40) * 0.8} viewBox="0 0 40 32" fill="none" stroke={color} stroke-width="1.5" aria-hidden="true"><rect x="2" y="7" width="36" height="23" rx="3" /><path d="M13 7l3-5h8l3 5" /><circle cx="20" cy="18" r="7" /></svg>
)}
{name === 'moth' && (
  <svg class={cls} style={style} width={size ?? 70} height={(size ?? 70) * 0.77} viewBox="0 0 70 54" fill="none" stroke="var(--ink)" stroke-width="1.2" stroke-linecap="round" aria-hidden="true"><path d="M35 14v28" /><path d="M35 18C26 4 6 2 4 14c-2 10 14 14 31 10z" fill="rgba(184,169,217,.35)" /><path d="M35 18C44 4 64 2 66 14c2 10-14 14-31 10z" fill="rgba(184,169,217,.35)" /><path d="M35 26c-8 2-20 8-16 18 4 6 12 0 16-12zM35 26c8 2 20 8 16 18-4 6-12 0-16-12z" fill="rgba(184,169,217,.2)" /><circle cx="18" cy="13" r="3" fill="rgba(230,196,106,.6)" stroke="none" /><circle cx="52" cy="13" r="3" fill="rgba(230,196,106,.6)" stroke="none" /><path d="M33 14c-2-6-6-10-10-12M37 14c2-6 6-10 10-12" /></svg>
)}
{name === 'candle' && (
  <svg class={cls} style={style} width={size ?? 40} height={(size ?? 40) * 1.6} viewBox="0 0 40 64" fill="none" aria-hidden="true"><ellipse cx="20" cy="14" rx="14" ry="14" fill="rgba(230,196,106,.18)" /><path d="M20 4c5 7 5 12 0 16-5-4-5-9 0-16z" fill="var(--honey)" /><rect x="13" y="24" width="14" height="30" rx="2" fill="var(--ink)" /><path d="M20 20v4" stroke="var(--parchment)" stroke-width="1.2" /><path d="M6 56h28" stroke="var(--ink)" stroke-width="1.3" stroke-linecap="round" /></svg>
)}
{name === 'constellation' && (
  <svg class={cls} style={style} width={size ?? 120} height={(size ?? 120) * 0.83} viewBox="0 0 120 100" fill="none" stroke="rgba(184,169,217,.5)" stroke-width="1" stroke-dasharray="3 5" aria-hidden="true"><path d="M10 20L70 60 105 30M70 60L90 95" /><circle cx="10" cy="20" r="2.5" fill="var(--ink)" stroke="none" /><circle cx="70" cy="60" r="3" fill="var(--honey)" stroke="none" /><circle cx="105" cy="30" r="2" fill="var(--ink)" stroke="none" /><circle cx="90" cy="95" r="2.5" fill="var(--ink)" stroke="none" /></svg>
)}
{name === 'crescent' && (
  <svg class={cls} style={style} width={size ?? 70} height={size ?? 70} viewBox="0 0 42 42" aria-hidden="true"><circle cx="21" cy="21" r="20" fill="rgba(230,196,106,.10)" /><path d="M26 5a16 16 0 1 0 11 27A13 13 0 0 1 26 5z" fill="var(--honey)" /><path d="M34 8l1 3 3 1-3 1-1 3-1-3-3-1 3-1z" fill="var(--ink)" /></svg>
)}
{name === 'sun' && (
  <svg class={cls} style={style} width={size ?? 18} height={size ?? 18} viewBox="0 0 24 24" fill="none" stroke="var(--honey)" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="var(--honey)" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M5 19l2-2M17 7l2-2" /></svg>
)}
{name === 'arrow' && (
  <svg class={cls} style={style} width={size ?? 26} height={(size ?? 26) * 0.54} viewBox="0 0 26 14" fill="none" stroke={color} stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M1 7c6-3 12 3 23 0" /><path d="M19 2l5 5-5 5" /></svg>
)}
