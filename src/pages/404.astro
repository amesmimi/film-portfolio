---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ornament from '../components/Ornament.astro';
import { url } from '../site.config';
---
<BaseLayout title="A missing page" compactHeader>
  <section class="lost">
    <Ornament name="mushroom" size={130} />
    <p class="caps">Page 404</p>
    <h1>This page seems to have been torn out.</h1>
    <p class="hand-accent">perhaps the fox borrowed it…</p>
    <a class="btn" href={url()}>Back to the beginning</a>
  </section>
</BaseLayout>

<style>
  .lost { max-width: 720px; margin: 0 auto; padding: 96px 24px 72px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  h1 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(40px, 6vw, 68px); line-height: 1.05; }
  .hand-accent { margin: 0 0 18px; }
</style>
